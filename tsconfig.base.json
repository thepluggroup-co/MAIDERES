{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@maideres/ui": ["./packages/ui/src"],
      "@maideres/ui/*": ["./packages/ui/src/*"],
      "@maideres/db": ["./packages/db/src"],
      "@maideres/db/*": ["./packages/db/src/*"],
      "@maideres/shared": ["./packages/shared/src"],
      "@maideres/shared/*": ["./packages/shared/src/*"],
      "@maideres/ai": ["./packages/ai/src"],
      "@maideres/ai/*": ["./packages/ai/src/*"],
      "@maideres/contracts": ["./packages/contracts/src"],
      "@maideres/contracts/*": ["./packages/contracts/src/*"]
    }
  },
  "exclude": ["node_modules"]
}
